---
// The page background: two scenes and the journey between them.
//
//   day   — a red sun over Fuji, sakura reaching in from the edges
//   night — a white moon over water, its reflection broken by ripples
//
// One value drives everything: `mix`, 0 at day and 1 at night. Toggling the
// theme animates it, so the sun sets as the moon rises and the lake fades in
// under it rather than the two scenes cutting.
//
// Two canvases on purpose. The scene is repainted only while that transition
// runs, or on resize, so at rest it costs nothing — which is what lets the
// canopy be a few thousand strokes. Only the petals repaint, and both canvases
// are fixed to the viewport, so their size never grows with the page.
---

<canvas id="scene" aria-hidden="true"></canvas>
<canvas id="sakura" aria-hidden="true"></canvas>

<script>
	type Petal = {
		x: number;
		y: number;
		depth: number;
		sway: number;
		phase: number;
		spin: number;
		flip: number;
		tone: number;
	};

	const sceneCanvas = document.getElementById('scene') as HTMLCanvasElement | null;
	const petalCanvas = document.getElementById('sakura') as HTMLCanvasElement | null;
	const scene = sceneCanvas?.getContext('2d');
	const sky = petalCanvas?.getContext('2d');

	if (sceneCanvas && petalCanvas && scene && sky) {
		const DAY = { ink: '#101113', orb: '#e10600', petal: '#f0b3ad', accent: '#e10600' };
		const NIGHT = { ink: '#e8ecf5', orb: '#f7f4ec', petal: '#dcbcc6', accent: '#ff5a6e' };

		const rgb = (hex: string): [number, number, number] => [
			parseInt(hex.slice(1, 3), 16),
			parseInt(hex.slice(3, 5), 16),
			parseInt(hex.slice(5, 7), 16),
		];
		const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
		const blend = (from: string, to: string, t: number) => {
			const a = rgb(from);
			const b = rgb(to);
			return `rgb(${Math.round(lerp(a[0], b[0], t))} ${Math.round(lerp(a[1], b[1], t))} ${Math.round(
				lerp(a[2], b[2], t),
			)})`;
		};

		// Fixed seeds: nothing in the scene may rearrange itself on a resize.
		const seeded = (seed: number) => () => {
			seed = (seed + 0x6d2b79f5) | 0;
			let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
			t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
			return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
		};

		const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const isNight = () => document.documentElement.dataset.theme === 'dark';

		let w = 0;
		let h = 0;
		let mix = isNight() ? 1 : 0;
		let target = mix;
		let petals: Petal[] = [];
		let frame = 0;
		let morph = 0;
		let last = 0;

		const waterY = () => h * lerp(0.86, 0.72, mix);
		const horizon = () => h * lerp(0.8, 0.665, mix);
		const orb = () => ({
			x: w * lerp(0.87, 0.74, mix),
			y: h * lerp(0.24, 0.2, mix),
			r: Math.min(w, h) * lerp(0.13, 0.105, mix),
		});

		/** One sakura limb system, reaching in from an edge. */
		const branch = (
			seed: number,
			sx: number,
			sy: number,
			angle: number,
			len: number,
			width: number,
			depth: number,
			ink: string,
			petal: string,
		) => {
			const rand = seeded(seed);

			const flower = (x: number, y: number, r: number) => {
				scene.globalAlpha = lerp(0.17, 0.3, mix) + rand() * 0.1;
				scene.fillStyle = petal;
				const turn = rand() * Math.PI;
				for (let i = 0; i < 5; i++) {
					const a = turn + (i / 5) * Math.PI * 2;
					scene.beginPath();
					scene.arc(x + Math.cos(a) * r * 0.72, y + Math.sin(a) * r * 0.72, r * 0.6, 0, Math.PI * 2);
					scene.fill();
				}
				scene.globalAlpha = lerp(0.3, 0.5, mix);
				scene.fillStyle = blend(DAY.accent, NIGHT.accent, mix);
				scene.beginPath();
				scene.arc(x, y, r * 0.22, 0, Math.PI * 2);
				scene.fill();
			};

			// Blossoms grow in umbels: several flowers on short stalks from one
			// node. Scattered single flowers are what makes a drawn tree look bare.
			const umbel = (x: number, y: number, count: number, spread: number, scale: number) => {
				for (let i = 0; i < count; i++) {
					const a = rand() * Math.PI * 2;
					const d = Math.sqrt(rand()) * spread;
					const fx = x + Math.cos(a) * d;
					const fy = y + Math.sin(a) * d;
					scene.globalAlpha = lerp(0.07, 0.13, mix);
					scene.strokeStyle = ink;
					scene.lineWidth = 0.7;
					scene.beginPath();
					scene.moveTo(x, y);
					scene.lineTo(fx, fy);
					scene.stroke();
					flower(fx, fy, scale * (0.55 + rand() * 1.05));
				}
			};

			const limb = (x: number, y: number, a: number, l: number, wd: number, d: number) => {
				const bend = (rand() - 0.45) * 0.75;
				const midX = x + Math.cos(a) * l * 0.55;
				const midY = y + Math.sin(a) * l * 0.55;
				const endX = x + Math.cos(a + bend) * l;
				const endY = y + Math.sin(a + bend) * l;

				// The wood is thin and dark, and the blossom covers most of it.
				scene.globalAlpha = lerp(0.16, 0.26, mix);
				scene.strokeStyle = ink;
				scene.lineWidth = wd;
				scene.beginPath();
				scene.moveTo(x, y);
				scene.quadraticCurveTo(midX, midY, endX, endY);
				scene.stroke();

				if (d <= 1) {
					umbel(endX, endY, 6 + Math.floor(rand() * 5), 13 + rand() * 13, 3.2);
					return;
				}
				if (d <= 4 && rand() < 0.85) {
					umbel(midX, midY, 3 + Math.floor(rand() * 4), 8 + rand() * 8, 3);
				}
				const twigs = d > 4 ? 2 : 2 + Math.floor(rand() * 2);
				for (let i = 0; i < twigs; i++) {
					const spread = (i - (twigs - 1) / 2) * (0.62 + rand() * 0.45);
					limb(endX, endY, a + bend + spread, l * (0.68 + rand() * 0.14), wd * 0.64, d - 1);
				}
			};

			limb(sx, sy, angle, len, width, depth);
		};

		/** Fuji: concave slopes, a flat crater, a snow cap that reads in both themes. */
		const fuji = (ink: string) => {
			const baseY = horizon();
			const height = h * 0.26;
			const half = height * 1.45;
			const cx = w * 0.46;
			const peakY = baseY - height;

			const outline = () => {
				scene.beginPath();
				scene.moveTo(cx - half, baseY);
				scene.bezierCurveTo(
					cx - half * 0.52, baseY - height * 0.45,
					cx - half * 0.2, peakY + height * 0.12,
					cx - half * 0.085, peakY,
				);
				scene.lineTo(cx + half * 0.085, peakY);
				scene.bezierCurveTo(
					cx + half * 0.2, peakY + height * 0.12,
					cx + half * 0.52, baseY - height * 0.45,
					cx + half, baseY,
				);
				scene.closePath();
			};

			scene.globalAlpha = lerp(0.065, 0.075, mix);
			scene.fillStyle = ink;
			outline();
			scene.fill();

			// Snow: lighter than the slope by day, lit by the moon at night.
			scene.save();
			outline();
			scene.clip();
			const capY = peakY + height * 0.3;
			scene.beginPath();
			scene.moveTo(cx - half, capY);
			for (let i = 0; i <= 10; i++) {
				const t = i / 10;
				scene.lineTo(cx - half + t * half * 2, capY - Math.sin(i * 2.3) * height * 0.055);
			}
			scene.lineTo(cx + half, peakY - height * 0.2);
			scene.lineTo(cx - half, peakY - height * 0.2);
			scene.closePath();
			scene.globalCompositeOperation = 'destination-out';
			scene.globalAlpha = (1 - mix) * 0.6;
			scene.fill();
			scene.globalCompositeOperation = 'source-over';
			scene.globalAlpha = mix * 0.11;
			scene.fillStyle = NIGHT.ink;
			scene.fill();
			scene.restore();
		};

		const drawScene = () => {
			const ink = blend(DAY.ink, NIGHT.ink, mix);
			const petal = blend(DAY.petal, NIGHT.petal, mix);
			const { x: orbX, y: orbY, r: orbR } = orb();
			scene.clearRect(0, 0, w, h);

			if (mix > 0.01) {
				const star = seeded(77003);
				scene.fillStyle = NIGHT.ink;
				for (let i = 0; i < 46; i++) {
					const sx = star() * w;
					const sy = star() * h * 0.62;
					scene.globalAlpha = mix * (0.15 + star() * 0.4);
					scene.beginPath();
					scene.arc(sx, sy, 0.6 + star() * 0.9, 0, Math.PI * 2);
					scene.fill();
				}
			}

			// Sun: a solid red disc, hinomaru rather than an outline.
			if (mix < 0.99) {
				scene.fillStyle = DAY.orb;
				scene.globalAlpha = (1 - mix) * 0.85;
				scene.beginPath();
				scene.arc(orbX, orbY, orbR, 0, Math.PI * 2);
				scene.fill();
				scene.strokeStyle = DAY.orb;
				scene.globalAlpha = (1 - mix) * 0.2;
				scene.lineWidth = 1;
				scene.beginPath();
				scene.arc(orbX, orbY, orbR * 1.32, 0, Math.PI * 2);
				scene.stroke();
			}

			// Moon: a solid disc with a halo and three shallow craters.
			if (mix > 0.01) {
				const halo = scene.createRadialGradient(orbX, orbY, orbR, orbX, orbY, orbR * 2.6);
				halo.addColorStop(0, 'rgb(231 236 246 / 0.16)');
				halo.addColorStop(1, 'rgb(231 236 246 / 0)');
				scene.globalAlpha = mix;
				scene.fillStyle = halo;
				scene.beginPath();
				scene.arc(orbX, orbY, orbR * 2.6, 0, Math.PI * 2);
				scene.fill();

				scene.fillStyle = NIGHT.orb;
				scene.globalAlpha = mix * 0.92;
				scene.beginPath();
				scene.arc(orbX, orbY, orbR, 0, Math.PI * 2);
				scene.fill();

				scene.fillStyle = '#0b1019';
				for (const [dx, dy, dr] of [
					[-0.3, -0.18, 0.17],
					[0.24, 0.26, 0.11],
					[0.05, -0.42, 0.07],
				]) {
					scene.globalAlpha = mix * 0.07;
					scene.beginPath();
					scene.arc(orbX + orbR * dx, orbY + orbR * dy, orbR * dr, 0, Math.PI * 2);
					scene.fill();
				}
			}

			fuji(ink);

			// Three ridges in front of the mountain.
			for (let layer = 0; layer < 3; layer++) {
				const base = horizon() + layer * h * 0.035;
				const amp = h * (0.1 - layer * 0.025);
				scene.beginPath();
				scene.moveTo(0, h);
				for (let x = 0; x <= w; x += 6) {
					const y =
						base -
						Math.sin(x / (280 - layer * 70) + layer * 2.1) * amp * 0.62 -
						Math.sin(x / (95 + layer * 35) + layer) * amp * 0.24;
					scene.lineTo(x, y);
				}
				scene.lineTo(w, h);
				scene.closePath();
				scene.globalAlpha = lerp(0.06, 0.05, mix) + layer * 0.03;
				scene.fillStyle = ink;
				scene.fill();
			}

			// The lake, night only: the ridges stand their feet in it.
			if (mix > 0.01) {
				const line = waterY();
				scene.globalAlpha = mix * 0.075;
				scene.fillStyle = NIGHT.ink;
				scene.fillRect(0, line, w, h - line);
				scene.globalAlpha = mix * 0.2;
				scene.fillRect(0, line, w, 1);
			}

			// Sakura reaching in from both sides, largest at the top left.
			const reach = Math.min(w * 0.13, h * 0.2);
			branch(20261020, -16, h * 0.01, 0.5, reach, 5, 5, ink, petal);
			branch(5512077, w + 16, h * 0.03, Math.PI - 0.46, reach * 0.78, 4, 5, ink, petal);
			branch(884413, -14, h * 0.58, -0.3, reach * 0.52, 2.8, 4, ink, petal);
			branch(310255, w + 14, h * 0.66, Math.PI + 0.26, reach * 0.46, 2.6, 4, ink, petal);
			branch(661902, -14, h * 0.27, 0.22, reach * 0.47, 2.7, 4, ink, petal);
			branch(427718, w + 14, h * 0.43, Math.PI - 0.2, reach * 0.44, 2.5, 4, ink, petal);

			scene.globalAlpha = 1;
		};

		const spawn = (fresh: boolean): Petal => ({
			x: Math.random() * w,
			y: fresh ? -20 : Math.random() * h,
			depth: Math.random(),
			sway: 14 + Math.random() * 26,
			phase: Math.random() * Math.PI * 2,
			spin: 0.6 + Math.random() * 1.4,
			flip: Math.random() * Math.PI * 2,
			tone: Math.random() < 0.17 ? 1 : 0,
		});

		const resize = () => {
			const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
			w = window.innerWidth;
			h = window.innerHeight;
			for (const c of [sceneCanvas, petalCanvas]) {
				c.width = Math.round(w * ratio);
				c.height = Math.round(h * ratio);
			}
			scene.setTransform(ratio, 0, 0, ratio, 0, 0);
			sky.setTransform(ratio, 0, 0, ratio, 0, 0);
			petals = Array.from({ length: Math.max(14, Math.min(44, Math.round(w / 30))) }, () =>
				spawn(false),
			);
			drawScene();
		};

		const drawPetals = (t: number) => {
			const tone = [blend(DAY.petal, NIGHT.petal, mix), blend(DAY.accent, NIGHT.accent, mix)];
			const line = waterY();
			sky.clearRect(0, 0, w, h);

			// The moon's reflection, broken into ripples. It lives on the animated
			// canvas so it can shimmer without repainting the whole scene.
			if (mix > 0.01) {
				const { x: orbX, r: orbR } = orb();
				sky.fillStyle = NIGHT.orb;
				for (let i = 0; i < 15; i++) {
					const down = i / 15;
					const y = line + 5 + down * (h - line - 5);
					const wob = Math.sin(t * 0.0011 + i * 0.85);
					const len = orbR * 1.5 * (0.32 + 0.68 * (1 - down)) * (0.72 + 0.28 * wob);
					sky.globalAlpha = mix * 0.34 * (1 - down * 0.72);
					sky.fillRect(orbX - len / 2 + wob * 5, y, len, 1.7);
				}
				sky.globalAlpha = mix * 0.07;
				for (let i = 0; i < 5; i++) {
					const y = line + 10 + i * ((h - line) / 5);
					sky.fillRect(0, y + Math.sin(t * 0.0008 + i) * 1.5, w, 1);
				}
			}

			for (const p of petals) {
				p.y += 0.22 + p.depth * 0.75;
				p.flip += 0.012 * p.spin;
				if (p.y > h + 24) {
					Object.assign(p, spawn(true));
					continue;
				}
				// At night the petals settle onto the water instead of sailing over it.
				const sink = mix > 0.01 && p.y > line ? Math.max(0, 1 - (p.y - line) / 55) : 1;
				if (sink <= 0) continue;

				const x = p.x + Math.sin(t * 0.0006 + p.phase) * p.sway;
				const size = 3.5 + p.depth * 6.5;
				sky.save();
				sky.translate(x, p.y);
				sky.rotate(Math.sin(p.flip * 0.5) * 0.9);
				// Horizontal squash stands in for tumbling through depth.
				sky.scale(Math.cos(p.flip) * 0.7 + 0.35, 1);
				sky.globalAlpha = (0.22 + p.depth * 0.5) * (p.tone ? 0.8 : 1) * sink;
				sky.fillStyle = tone[p.tone];
				sky.beginPath();
				sky.moveTo(0, -size);
				sky.bezierCurveTo(size * 0.78, -size * 0.55, size * 0.62, size * 0.62, 0, size);
				sky.bezierCurveTo(-size * 0.62, size * 0.62, -size * 0.78, -size * 0.55, 0, -size);
				sky.closePath();
				sky.fill();
				sky.restore();
			}
			sky.globalAlpha = 1;
		};

		const loop = (t: number) => {
			frame = requestAnimationFrame(loop);
			if (t - last < 33) return; // 30fps is plenty for drifting petals
			last = t;
			drawPetals(t);
		};

		const run = () => {
			if (frame || still || document.hidden) return;
			last = 0;
			frame = requestAnimationFrame(loop);
		};

		const halt = () => {
			if (!frame) return;
			cancelAnimationFrame(frame);
			frame = 0;
		};

		// Sunset into moonrise: 900ms, ease-out, the scene repainting only here.
		const travel = () => {
			const from = mix;
			const started = performance.now();
			cancelAnimationFrame(morph);
			const step = (now: number) => {
				const p = Math.min(1, (now - started) / 900);
				mix = from + (target - from) * (1 - Math.pow(1 - p, 3));
				drawScene();
				if (p < 1) morph = requestAnimationFrame(step);
			};
			morph = requestAnimationFrame(step);
		};

		window.addEventListener('themechange', (event) => {
			target = (event as CustomEvent<string>).detail === 'dark' ? 1 : 0;
			if (still) {
				mix = target;
				drawScene();
				drawPetals(0);
			} else {
				travel();
			}
		});

		resize();
		drawPetals(0);
		window.addEventListener('resize', resize);
		document.addEventListener('visibilitychange', () => (document.hidden ? halt() : run()));
		run();
	}
</script>
